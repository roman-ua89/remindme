generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BlockType {
  text
  code
  image
  list
  link
}

enum EntityVisibility {
  included
  excluded
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  passwordHash    String   @map("password_hash")
  displayName     String?  @map("display_name")
  isActive        Boolean  @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles            UserRole[]
  passwordResetTokens  PasswordResetToken[]
  categories           Category[]
  mediaAssets          MediaAsset[]
  dailyActivity        UserDailyActivity[]

  @@map("users")
}

/// Per-user, per-local-day revision counters. Incremented only by Player Done/Skip;
/// add new counter columns here for future daily metrics.
model UserDailyActivity {
  userId       String   @map("user_id") @db.Uuid
  /// User's local calendar day (timezone from the X-Timezone request header)
  activityDate DateTime @map("activity_date") @db.Date
  revisedCount Int      @default(0) @map("revised_count")
  skippedCount Int      @default(0) @map("skipped_count")
  /// Seconds the Player page was open on this day
  playerSeconds Int     @default(0) @map("player_seconds")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, activityDate])
  @@map("user_daily_activity")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics Topic[]

  @@index([userId, position])
  @@map("categories")
}

model Topic {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  name       String
  position   Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  entities Entity[]

  @@index([categoryId, position])
  @@map("topics")
}

model Entity {
  id            String           @id @default(uuid()) @db.Uuid
  topicId       String           @map("topic_id") @db.Uuid
  title         String
  position      Int
  revisedCount  Int              @default(0) @map("revised_count")
  skippedCount  Int              @default(0) @map("skipped_count")
  /// Player ordering: revisedCount + offset set at creation (min of topic, else category), so new entities join the current tier
  scheduleCount Int              @default(0) @map("schedule_count")
  visibility    EntityVisibility @default(included)
  /// null = no marker; 1 = needs edit; 2 = to remove (see ENTITY_MARKER in @remindme/contracts/entities)
  marker        Int?             @db.SmallInt
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Set only when saved from Constructor edit mode (PATCH entity); null = never edited
  editedAt      DateTime?        @map("edited_at") @db.Timestamptz(6)

  topic  Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  blocks EntityBlock[]

  @@index([topicId, position])
  @@index([topicId, visibility, scheduleCount])
  @@map("entities")
}

model EntityBlock {
  id           String    @id @default(uuid()) @db.Uuid
  entityId     String    @map("entity_id") @db.Uuid
  blockType    BlockType @map("block_type")
  position     Int
  contentJson  Json?     @map("content_json")
  mediaAssetId String?   @map("media_asset_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  entity     Entity          @relation(fields: [entityId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset?     @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  listRows   ListBlockRow[]

  @@unique([entityId, position])
  @@map("entity_blocks")
}

model ListBlockRow {
  id         String @id @default(uuid()) @db.Uuid
  blockId    String @map("block_id") @db.Uuid
  position   Int
  leftValue  String @map("left_value")
  rightValue String @map("right_value")

  block EntityBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, position])
  @@map("list_block_rows")
}

model MediaAsset {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  storageKey       String   @map("storage_key")
  mimeType         String   @map("mime_type")
  byteSize         BigInt   @map("byte_size")
  originalFilename String?  @map("original_filename")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks EntityBlock[]

  @@index([userId])
  @@map("media_assets")
}
