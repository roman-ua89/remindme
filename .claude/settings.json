{
  "model": "claude-opus-5-5",
  "effortLevel": "xhigh",
  "permissions": {
    "allow": [
      "Bash(docker compose *)",
      "Bash(npx prisma *)",
      "Bash(python3 -)",
      "Bash(npm run *)",
      "Bash(npx prettier *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)"
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "30"
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "context7"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh" }]
      }
    ]
  }
}
